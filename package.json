{
  "name": "nekoria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @nekoria/web --filter @nekoria/server dev",
    "dev:web": "pnpm --filter @nekoria/web dev",
    "dev:server": "pnpm --filter @nekoria/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": { "typescript": "^5.9.2" }
}
